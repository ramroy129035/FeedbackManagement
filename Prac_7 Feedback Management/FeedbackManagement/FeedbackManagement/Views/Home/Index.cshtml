@{
    ViewData["Title"] = "Home";
}

<div class="container">

    <div class="p-5 mb-4 bg-primary text-white rounded-3 text-center">

        <h1 class="display-4 fw-bold">
            Welcome to Feedback Management System
        </h1>

        <p class="lead mt-3">
            Your Feedback Helps Us Improve Our Services.
        </p>

        <a asp-controller="Home"
           asp-action="Create"
           class="btn btn-light btn-lg mt-3">
            Submit Your Feedback
        </a>

    </div>

    <h2 class="text-center mb-4">Our Features</h2>

    <div class="row">

        <div class="col-md-4 mb-3">
            <div class="card shadow h-100">
                <div class="card-body text-center">
                    <h4>Easy Feedback</h4>
                    <p>Submit your feedback easily through our online form.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow h-100">
                <div class="card-body text-center">
                    <h4>Form Validation</h4>
                    <p>All fields are validated to ensure correct information.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow h-100">
                <div class="card-body text-center">
                    <h4>User Friendly</h4>
                    <p>Simple and responsive interface for students.</p>
                </div>
            </div>
        </div>

    </div>

</div>